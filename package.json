{
  "name": "print-ui",
  "version": "0.1.0",
  "private": true,
  "description": "UI to send files to print-service API",
  "author": {
    "name": "dyakovri"
  },
  "scripts": {
    "start": "vue-cli-service serve --port 9004",
    "build": "vue-cli-service build",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "main": "index.js",
  "dependencies": {
    "axios": "1.21.1",
    "core-js": "3.51.0",
    "register-service-worker": "1.7.2",
    "vue": "3.5.45",
    "vue-qrcode-reader": "5.7.3",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "24.19.2",
    "@vue/cli-plugin-babel": "5.0.9",
    "@vue/cli-plugin-pwa": "5.0.9",
    "@vue/cli-plugin-typescript": "5.0.9",
    "@vue/cli-service": "5.0.9",
    "@vue/compiler-sfc": "3.5.45",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "^10.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14",
    "zxing-wasm": "1.1.3"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "_id": "print-ui@0.1.0",
  "keywords": [
    "print",
    "ui",
    "api",
    "vue"
  ],
  "license": "BSD-2-Clause",
  "readme": "README.md",
  "repository": {
    "type": "git",
    "url": "https://git.dyakov.space/student-union/print-ui"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12 <13"
  }
}
